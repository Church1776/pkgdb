#!/usr/bin/zsh

args=("$@")
targs=()

for arg in "${args[@]}"; do
  case $arg in
    --*) OPT_TYPE="long";;
    -*) OPT_TYPE="short";;
    html) BUILD_MODE="html";;
    *)echo "unknown option.";;
  esac
  targs=("$arg")
  if [[ "$OPT_TYPE" == "short" ]]; then
    chars=(${(%s..)targs#-})
    targs=()
    for c in "${chars}"; do
      case "$c" in
        a) targs+=("--all");;
        h) targs+=("--help");;
        v) targs+=("--version");;
        *) echo "Unknown argument: '-$c'";;
      esac
    done
    OPT_TYPE="long"
  fi
  if [[ "$OPT_TYPE" == "long" ]]; then
    for ta in "${targs}"; do
      case "${ta#--}" in
        help) echo "Not implemented yet.";;
        version) echo "Not implemented yet.";;
        *) echo "Unknown argument: '$ta'";;
      esac
    done
  fi
done
unset targs
if [[ ${zsh_eval_context[-1]} == file ]]; then
  printf '%s\n' \
  'This file is not meant to be sourced.' \
  'Execute this file for correct usage.'
  return
fi

pkgdb_root="$(git rev-parse --show-toplevel)"
if [[ $pkgdb_root == [a-zA-Z]':'* ]]; then
  if [[ ${+commands[cygpath]} ]]; then
    pkgdb_root="$(cygpath -u $pkgdb_root)"
  fi
fi

if [[ $PWD != $pkgdb_root ]]; then
  cd $pkgdb_root
fi
__='  '
OUTPUT_FILENAME='index.html'
FIND_TYPE=""
PAGE_NAME=""
WEBPAGE=""
DOCTYPE='<!DOCTYPE html>'
HTML='<html class="">'
XHTML='</html>'
HEAD='<head class="">'
XHEAD='</head>'
METADATA=()
PAGE_CONTENTS=""
while IFS= read -r line; do
  METADATA+=("$line")
done < 'docs/html/metadata'
TITLE='<title class="">'
XTITLE='</title>'
BODY='<body class="">'
XBODY='</body>'
H1='<h1 class="">'
XH1='</h1>'
H2='<h2 class="">'
XH2='</h2>'
H3='<h3 class="">'
XH3='</h3>'
H4='<h4 class="">'
XH4='</h4>'
H5='<h5 class="">'
XH5='</h5>'
H6='<h6 class="">'
XH6='</h6>'
UL='<ul class="">'
XUL='</ul>'
LI='<li class="">'
XLI='</li>'
HEADER='<header class="">'
XHEADER='</header>'
MAIN='<main class="">'
XMAIN='</main>'
NAV='<nav class="">'
XNAV='</nav>'
SECTION='<section class="">'
XSECTION='</section>'
ARTICLE='<article class="">'
XARTICLE='</article>'
ASIDE='<aside class="">'
XASIDE='</aside>'
DIV='<div class="">'
XDIV='</div>'
FOOTER='<footer class="">'
XFOOTER='</footer>'
# Grab html head to set the page configs
echo "Generating webpages..."
WEBDIRS=($(find . -maxdepth 1 -type d ! -name .git ! -name docs ! -name html ! -name pkg ! -name fonts | sed 's|\./||g' | sort))

for wdir in "${WEBDIRS[@]}"; do
#  echo "'$wdir/'"

  wtitle="$wdir"
  padding=''

  WEBPAGE="$(echo "${padding}${DOCTYPE}")\n"
  WEBPAGE+="$(echo "${padding}${HTML}")\n"
  WEBPAGE+="$(echo "${padding}${HEAD}")\n"

  if [[ "$wdir/" == './' ]]; then  
    PAGE_NAME="Church1776's Package Database"
    PAGE_CONTENTS=($(find . -maxdepth 1 -type d ! -name .git ! -name docs ! -name html ! -name pkg ! -name fonts | sed 's|\./||g' | sort))
    for (( i=1; i<=${#PAGE_CONTENTS}; ++i )); do
      PAGE_CONTENTS[$i]+="/"
    done
    echo "'$wdir/' $PAGE_NAME"
  else
    case "$wtitle" in
      msvc) wtitle='MSVC';;
      ios) wtitle='iOS';;
      *bsd) wtitle="${wtitle//bsd/BSD}";|
      *os) wtitle="${wtitle//os/OS}";|
      *) wtitle="${(U)wtitle[1]}${wtitle[2,-1]}"
    esac
    PAGE_NAME="Church1776's $wtitle Repository"
    PAGE_CONTENTS=($(find "$wdir/" -maxdepth 1 -type f ! -name '*.html' ! -name '*.css' ! -name '*.js' | sed "s|$wdir/||g" | sort))
    DIRSLASH=''
    echo "'$wdir/' $PAGE_NAME"
fi
  if [[ -n "$METADATA" ]]; then
    echo "Metadata NOT empty"
    padding+="$__"
    case "$PAGE_NAME" in
      *Database*)
        for (( i=1; i <= ${#METADATA}; ++i )); do
          METADATA[$i]="${METADATA[$i]//\"..\/docs\//\"docs/}"
        done
        ;;
      *Repository*)
        for (( i=1; i <= ${#METADATA}; ++i )); do
          METADATA[$i]="${METADATA[$i]//\"docs\//\"../docs/}"
        done
        ;;
    esac
    for md in ${METADATA[@]}; do
      WEBPAGE+="$(echo "${padding}${md}")\n"
    done
    padding+="$__"
  fi
  padding+="$__"
  WEBPAGE+="$(echo "${padding}${TITLE}${PAGE_NAME}${XTITLE}")\n"
  padding+="$__"
  WEBPAGE+="$(echo "${padding}${XHEAD}")\n"
  WEBPAGE+="$(echo "${padding}${BODY}")\n"
  padding+="$__"
  WEBPAGE+="$(echo "${padding}${HEADER}")\n"
  padding+="$__"
  WEBPAGE+="$(echo "${padding}${H1}${PAGE_NAME}${XH1}")\n"
  padding+="$__"
  WEBPAGE+="$(echo "${padding}${XHEADER}")\n"
  padding+="$__"
  if [[ -n "${PAGE_CONTENTS}" ]]; then

    padding+="$__"
    WEBPAGE+="$(echo "${padding}${NAV}")\n"
    padding+="$__"

    case "$PAGE_NAME" in
      *Database) WEBPAGE+="$(echo "${padding}${H2}Repositories${XH2}")\n";;
      *Repository) WEBPAGE+="$(echo "${padding}${H2}Navigation${XH2}")\n"
        WEBPAGE+="$(echo "${padding}${UL}")\n"
        WEBPAGE+="$(echo "${padding}${__}${LI}<a href=\"../\">Home${XLI}")\n"
        WEBPAGE+="$(echo "${padding}${XUL}")\n"
    esac

    if [[ "${PAGE_CONTENTS[1]}" == */ ]]; then
    
      WEBPAGE+="$(echo "${padding}${UL}")\n"
      padding+="$__"
    
      for pc in "${PAGE_CONTENTS[@]}"; do
        WEBPAGE+="${padding}${LI}<a href=\"${pc}\">${pc}${XLI}\n"
      done
    
      padding+="$__"
      WEBPAGE+="$(echo "${padding}${XUL}")\n"
      padding+="$__"
      WEBPAGE+="$(echo "${padding}${XNAV}")\n"
    else
      padding+="$__"
      WEBPAGE+="$(echo "${padding}${XNAV}")\n"
    fi

    padding+="$__"
    
    padding+="$__"
    WEBPAGE+="$(echo "${padding}${XMAIN}")\n"
    padding+="$__"
  fi
  WEBPAGE+="$(echo "${padding}${XBODY}")\n"
  WEBPAGE+="$(echo "${padding}${XHTML}")\n"
  echo "$WEBPAGE" > "$wdir/$OUTPUT_FILENAME"
done
