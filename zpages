#!/usr/bin/zsh

args=("$@")
targs=()

for arg in "${args[@]}"; do
  case $arg in
    --*) OPT_TYPE="long";;
    -*) OPT_TYPE="short";;
    html) BUILD_MODE="html";;
    *)echo "unknown option.";;
  esac
  targs=("$arg")
  if [[ "$OPT_TYPE" == "short" ]]; then
    chars=(${(%s..)targs#-})
    targs=()
    for c in "${chars}"; do
      case "$c" in
        a) targs+=("--all");;
        h) targs+=("--help");;
        v) targs+=("--version");;
        *) echo "Unknown argument: '-$c'";;
      esac
    done
    OPT_TYPE="long"
  fi
  if [[ "$OPT_TYPE" == "long" ]]; then
    for ta in "${targs}"; do
      case "${ta#--}" in
        help) echo "Not implemented yet.";;
        version) echo "Not implemented yet.";;
        *) echo "Unknown argument: '$ta'";;
      esac
    done
  fi
done
unset targs
if [[ ${zsh_eval_context[-1]} == file ]]; then
  printf '%s\n' \
  'This file is not meant to be sourced.' \
  'Execute this file for correct usage.'
  return
fi

pkgdb_root="$(git rev-parse --show-toplevel)"
if [[ $pkgdb_root == [a-zA-Z]':'* ]]; then
  if [[ ${+commands[cygpath]} ]]; then
    pkgdb_root="$(cygpath -u $pkgdb_root)"
  fi
fi

if [[ $PWD != $pkgdb_root ]]; then
  cd $pkgdb_root
fi
OUTPUT_FILENAME='test.index.html'
FIND_TYPE=""
PAGE_NAME=""
WEBPAGE=""
DOCTYPE='<!DOCTYPE html>'
HTML='<html class="">'
XHTML='</html>'
HEAD='<head class="">'
XHEAD='</head>'
CONFIGS=()
PAGE_CONTENTS=""
while IFS= read -r line; do
  CONFIGS+=("$line")
done < 'docs/html/metadata'
TITLE='<title class="">'
XTITLE='</title>'
BODY='<body class="">'
XBODY='</body>'
H1='<h1 class="">'
XH1='</h1>'
H2='<h2 class="">'
XH2='</h2>'
H3='<h3 class="">'
XH3='</h3>'
H4='<h4 class="">'
XH4='</h4>'
H5='<h5 class="">'
XH5='</h5>'
H6='<h6 class="">'
XH6='</h6>'
HEADER='<header class="">'
XHEADER='</header>'
MAIN='<main class="">'
XMAIN='</main>'
NAV='<nav class="">'
XNAV='</nav>'
SECTION='<section class="">'
XSECTION='</section>'
ARTICLE='<article class="">'
XARTICLE='</article>'
ASIDE='<aside class="">'
XASIDE='</aside>'
DIV='<div class="">'
XDIV='</div>'
FOOTER='<footer class="">'
XFOOTER='</footer>'
# Grab html head to set the page configs
echo "Generating webpages..."
WEBDIRS=($(find . -maxdepth 1 -type d ! -name .git ! -name docs ! -name html ! -name pkg ! -name fonts | sed 's|\./||g' | sort))

for wdir in "${WEBDIRS[@]}"; do
  echo "'$wdir/'"
  padding=''
  WEBPAGE="$(echo "${padding}${DOCTYPE}")\n"
  WEBPAGE+="$(echo "${padding}${HTML}")\n"
  WEBPAGE+="$(echo "${padding}${HEAD}")\n"
  padding='  '

  repos=()
  contents=()
  wtitle="$wdir"
  if [[ "$wdir/" == './' ]]; then
  
    case "$CONFIGS" in
      *'"../docs/'*)
        for (( i=1; i <= ${#CONFIGS}; ++i )); do
          CONFIGS[$i]="${CONFIGS[$i]//\"..\/docs\//\"docs/}"
        done
        ;;
    esac
  
    PAGE_NAME="Church1776's Package Database"
  else
    while IFS= read -r found; do
      repos+=("$found")
    done <<< "$(find -maxdepth 1 -type d ! -name .git ! -name docs ! -name fonts ! -name pkg | sed 's|\./||g')"
    
    for repo in "${repos[@]}"; do
      if [[ "$repo" == '.' ]]; then
        continue
      fi
      contents=()
      while IFS= read -r pkg; do
        contents+=("$pkg")
      done <<< "$(find "$repo" -maxdepth 1 -type f ! -name '*.html' ! -name '*.md' ! -name '*.rst' ! -name '*.css' | sed 's|\./||g')"
      
      if [[ -z "$contents" ]]; then
        continue
      else
        padding='  '
        PAGE_CONTENTS="$(echo "${padding}${HEADER}")"
        PAGE_CONTENTS+="$(echo "${padding}${H1}${repo}${XH1}")\n"
        PAGE_CONTENTS+="$(echo "${padding}${XHEADER}")\n"
      fi
      if [[ "$repo" == 'msvc' || "$repo" == 'msys2' || "$repo" == 'cygwin' ]]; then
        :
      fi
    done
  else
    case "$CONFIGS" in
      *'"docs/'*) 
        for (( i=1; i <= ${#CONFIGS}; ++i )); do
          CONFIGS[$i]="${CONFIGS[$i]//\"docs\//\"../docs/}"
        done
        ;;
    esac
    case "$wtitle" in
      msvc) wtitle='MSVC';;
      ios) wtitle='iOS';;
      *os?*) :;;
      *bsd) wtitle="${wtitle//bsd/BSD}";|
      *os) wtitle="${wtitle//os/OS}";|
      *) wtitle="${(U)wtitle[1]}${wtitle[2,-1]}"
    esac
    PAGE_NAME="Church1776's $wtitle Repository"
  fi
  for conf in ${CONFIGS[@]}; do
    WEBPAGE+="$(echo "${padding}${conf}")\n"
  done
  WEBPAGE+="$(echo "${padding}${TITLE}${PAGE_NAME}${XTITLE}")\n"
  padding=''
  WEBPAGE+="$(echo "${padding}${XHEAD}")\n"
  WEBPAGE+="$(echo "${padding}${BODY}")\n"
  WEBPAGE+="${PAGE_CONTENTS}"
  padding=''
  WEBPAGE+="$(echo "${padding}${XBODY}")\n"
  WEBPAGE+="$(echo "${padding}${XHTML}")\n"
  echo "$WEBPAGE" > "$wdir/tmp.index.html"
done
