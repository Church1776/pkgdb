#!/usr/bin/zsh

args=("$@")
targs=()

for arg in "${args[@]}"; do
  case $arg in
    --*) OPT_TYPE="long";;
    -*) OPT_TYPE="short";;
    html) BUILD_MODE="html";;
    *)echo "unknown option.";;
  esac
  targs=("$arg")
  if [[ "$OPT_TYPE" == "short" ]]; then
    chars=(${(%s..)targs#-})
    targs=()
    for c in "${chars}"; do
      case "$c" in
        a) targs+=("--all");;
        h) targs+=("--help");;
        v) targs+=("--version");;
        *) echo "Unknown argument: '-$c'";;
      esac
    done
    OPT_TYPE="long"
  fi
  if [[ "$OPT_TYPE" == "long" ]]; then
    for ta in "${targs}"; do
      case "${ta#--}" in
        help) echo "Not implemented yet.";;
        version) echo "Not implemented yet.";;
        *) echo "Unknown argument: '$ta'";;
      esac
    done
  fi
done
unset targs
if [[ ${zsh_eval_context[-1]} == file ]]; then
  printf '%s\n' \
  'This file is not meant to be sourced.' \
  'Execute this file for correct usage.'
  return
fi

pkgdb_root="$(git rev-parse --show-toplevel)"
if [[ $pkgdb_root == [a-zA-Z]':'* ]]; then
  if [[ ${+commands[cygpath]} ]]; then
    pkgdb_root="$(cygpath -u $pkgdb_root)"
  fi
fi

if [[ $PWD != $pkgdb_root ]]; then
  cd $pkgdb_root
fi
OUTPUT_FILENAME='test.index.html'
PAGE_NAME=""
WEBPAGE=""
DOCTYPE='<!DOCTYPE html>'
HTML='<html class="">'
XHTML='</html>'
HEAD='<head class="">'
XHEAD='</head>'
CONFIGS=()
while IFS= read -r line; do
  CONFIGS+=("$line")
done < 'docs/html/metadata'
TITLE='<title class="">'
XTITLE='</title>'
BODY='<body class="">'
XBODY='</body>'
H1='<h1 class="">'
XH1='</h1>'
H2='<h2 class="">'
XH2='</h2>'
H3='<h3 class="">'
XH3='</h3>'
H4='<h4 class="">'
XH4='</h4>'
H5='<h5 class="">'
XH5='</h5>'
H6='<h6 class="">'
XH6='</h6>'
HEADER='<header class="">'
XHEADER='</header>'
MAIN='<main class="">'
XMAIN='</main>'
NAV='<nav class="">'
XNAV='</nav>'
SECTION='<section class="">'
XSECTION='</section>'
ARTICLE='<article class="">'
XARTICLE='</article>'
ASIDE='<aside class="">'
XASIDE='</aside>'
DIV='<div class="">'
XDIV='</div>'
FOOTER='<footer class="">'
XFOOTER='</footer>'
# Grab html head to set the page configs
echo "Generating webpages..."
WEBDIRS=($(find . -maxdepth 1 -type d ! -name .git ! -name docs ! -name html ! -name pkg ! -name fonts | sed 's|\./||g' | sort))

echoti sc
for wdir in "${WEBDIRS[@]}"; do
  echoti rc
  echoti ed
  echo "'$wdir/'"
  padding=''
  repos=()
  contents=()
  wtitle="$wdir"
  if [[ "$wdir/" == './' ]]; then
  
    case "$CONFIGS" in
      *'"../docs/'*)
        for (( i=1; i <= ${#CONFIGS}; ++i )); do
          CONFIGS[$i]="${CONFIGS[$i]//\"..\/docs\//\"docs/}"
        done
        ;;
    esac
  
    PAGE_NAME="Church1776's Package Database"
    
    while IFS= read -r found; do
      repos+=("$found")
    done <<< "$(find -maxdepth 1 -type d ! -name .git ! -name docs ! -name fonts ! -name pkg | sed 's|\./||g')"
    
    for repo in "${repos[@]}"; do
      if [[ "$repo" == '.' ]]; then
        continue
      fi
      contents=()
      while IFS= read -r pkg; do
        contents+=("$pkg")
      done <<< "$(find "$repo" -maxdepth 1 -type f ! -name '*.html' ! -name '*.md' ! -name '*.rst' ! -name '*.css' | sed 's|\./||g')"
      
      if [[ -z "$contents" ]]; then
        continue
      else
        H1="${H1:-"$(read -r line < docs/html/body/main/h1; print "$line")"}"
      fi
      if [[ "$repo" == 'msvc' || "$repo" == 'msys2' || "$repo" == 'cygwin' ]]; then
        :
      fi
    done
  else
    case "$CONFIGS" in
      *'"docs/'*) 
        for (( i=1; i <= ${#CONFIGS}; ++i )); do
          CONFIGS[$i]="${CONFIGS[$i]//\"docs\//\"../docs/}"
        done
        ;;
    esac
    case "$wtitle" in
      msvc) wtitle='MSVC';;
      ios) wtitle='iOS';;
      *os?*) :;;
      *bsd) wtitle="${wtitle//bsd/BSD}";|
      *os) wtitle="${wtitle//os/OS}";|
      *) wtitle="${(U)wtitle[1]}${wtitle[2,-1]}"
    esac
    PAGE_NAME="Church1776's $wtitle Repository"
  fi
  
  echo "${padding}${DOCTYPE}"
  echo "${padding}${HTML}"
  echo "${padding}${HEAD}"
  padding='  '
  for conf in ${CONFIGS[@]}; do
  echo "${padding}${conf}"
  done
  echo "${padding}${TITLE}${PAGE_NAME}${XTITLE}"
  padding=''
  echo "${padding}${XHEAD}"
  echo "${padding}${BODY}"
  padding='  '
  echo "${padding}${HEADER}"
  padding='    '
  echo "${padding}${H1}${PAGE_NAME}${XH1}"
  padding='  '
  echo "${padding}${XHEADER}"
  echo "${padding}${NAV}"
  padding='    '
  padding='  '
  echo "${padding}${XNAV}"
  echo "${padding}${MAIN}"
  padding='    '
  padding='  '
  echo "${padding}${XMAIN}"
  echo "${padding}${SECTION}"
  padding='    '
  padding='  '
  echo "${padding}${XSECTION}"
  echo "${padding}${ARTICLE}"
  padding='    '
  padding='  '
  echo "${padding}${XARTICLE}"
  echo "${padding}${ASIDE}"
  padding='    '
  padding='  '
  echo "${padding}${XASIDE}"
  echo "${padding}${FOOTER}"
  padding='    '
  padding='  '
  echo "${padding}${XFOOTER}"
  padding=''
  echo "${padding}${XBODY}"
  echo "${padding}${XHTML}"
  sleep 0.2
done
