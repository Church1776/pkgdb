#!/usr/bin/zsh

args=("$@")
targs=()

for arg in "${args[@]}"; do
  case $arg in
    --*) OPT_TYPE="long";;
    -*) OPT_TYPE="short";;
    html) BUILD_MODE="html";;
    *)echo "unknown option.";;
  esac
  targs=("$arg")
  if [[ "$OPT_TYPE" == "short" ]]; then
    chars=(${(%s..)targs#-})
    targs=()
    for c in "${chars}"; do
      case "$c" in
        a) targs+=("--all");;
        h) targs+=("--help");;
        v) targs+=("--version");;
        *) echo "Unknown argument: '-$c'";;
      esac
    done
    OPT_TYPE="long"
  fi
  if [[ "$OPT_TYPE" == "long" ]]; then
    for ta in "${targs}"; do
      case "${ta#--}" in
        help) echo "Not implemented yet.";;
        version) echo "Not implemented yet.";;
        *) echo "Unknown argument: '$ta'";;
      esac
    done
  fi
done
unset targs
if [[ ${zsh_eval_context[-1]} == file ]]; then
  printf '%s\n' \
  'This file is not meant to be sourced.' \
  'Execute this file for correct usage.'
  return
fi

pkgdb_root="$(git rev-parse --show-toplevel)"
if [[ $pkgdb_root == [a-zA-Z]':'* ]]; then
  if [[ ${+commands[cygpath]} ]]; then
    pkgdb_root="$(cygpath -u $pkgdb_root)"
  fi
fi

if [[ $PWD != $pkgdb_root ]]; then
  cd $pkgdb_root
fi
HTML_DOCTYPE='<!DOCTYPE html>'
HTML_HTML='<html>'
HTML_HEAD='<head>'
HTML_XHEAD='</head>'
HTML_BODY='<body>'
HTML_XBODY='</body>'
HTML_MAIN='<main>'
HTML_XMAIN='</main>'
HTML_NAV='<nav>'
HTML_XNAV='</nav>'
HTML_XHTML='</html>'
HTML_CONFIGS=("$(cat 'docs/html/head')")
# Grab html head to set the page configs
echo "FIND"
WEBDIRS=($(find . -maxdepth 1 -type d ! -name .git ! -name docs ! -name html ! -name pkg ! -name fonts | sed 's|\./||g' | sort))

for wdir in "${WEBDIRS[@]}"; do
  echo "\n'$wdir/'"
  wtitle="$wdir"
  if [[ "$wdir" = '.' ]]; then
    case "$HTML_CONFIGS" in
      *'"../docs/'*) HTML_CONFIGS="${HTML_CONFIGS//\"..\/docs\//\"docs/}"; echo "Setting docs path: docs.";;
    esac
    HTML_TITLE="  <title>Church1776's Package Database</title>"
  else
    case "$HTML_CONFIGS" in
      *'"docs/'*) HTML_CONFIGS="${HTML_CONFIGS//\"docs\//\"../docs/}"; echo "Setting docs path: ../docs.";;
    esac
    case "$wtitle" in
      msvc) wtitle='MSVC';;
      ios) wtitle='iOS';;
      *os?*) ;;
      *bsd) wtitle="${wtitle//bsd/BSD}";|
      *os) wtitle="${wtitle//os/OS}";|
      *) wtitle="${(U)wtitle[1]}${wtitle[2,-1]}"
    esac
    HTML_TITLE="  <title>Church1776's $wtitle Repository</title>"
  fi
  echo "$HTML_DOCTYPE"
  echo "$HTML_HTML"
  echo "$HTML_HEAD"
  for conf in ${HTML_CONFIGS[@]}; do
  echo "  '$conf'"
  done
  echo "$HTML_TITLE"
  echo "$HTML_XHEAD"
  echo "$HTML_BODY"
  echo "$HTML_MAIN"
  echo "$HTML_XMAIN"
  echo "$HTML_NAV"
  echo "$HTML_XNAV"
  echo "$HTML_XBODY"
  echo "$HTML_XHTML"
done