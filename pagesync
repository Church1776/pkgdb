#!/usr/bin/zsh

args=("$@")

if [[ ${zsh_eval_context[-1]} == file ]]; then
  printf '%s\n' \
  'This file is not meant to be sourced.' \
  'Execute this file for correct usage.'
  return
fi

pkgdb_root="$(git rev-parse --show-toplevel)"

if [[ $PWD != $pkgdb_root ]]; then
  cd $pkgdb_root
fi

function format_li_obj {
  li_obj="$1"
  li_padding="$2"
  li_obj="$li_padding<li><a href=\"$li_ibj\">$li_obj</a></li>"
  echo $li_obj
}
function clear_ul_lists {
  local repo="${1:h}"
  local idx="${1:t}"
  local tidx="tmp.$idx"
  local in_ul
  echo '' > $repo/$tidx
  while IFS= read -r line; do
    if [[ $line == *'</ul'* ]]; then
      in_ul=0
    fi
    if [[ $in_ul == 1 ]]; then
      continue
    fi
    echo $line >> $repo/$tidx
    if [[ $line == *'<ul'* ]]; then
      in_ul=1
    fi
  done < "$repo/$idx"
}
function update_ul_lists {
  local repo="${1:h}"
  local idx="${1:t}"
  local tidx="tmp.$idx"
  local in_ul ul_padding tmp_ln
  objs=($(find $repo -maxdepth 1 ! -name '*.html' ! -name '*.css' ! -name 'pagesync' ))
  echo '' > $repo/$tidx
  while IFS= read -r line; do
    if [[ $line == *'</ul'* ]]; then
      in_ul=0
      ul_padding=''
    fi
    if [[ $in_ul == 1 ]]; then
      for o in ${objs[@]}; do
        if [[ $o == $repo ]]; then
          continue
        fi
        format_li_obj "$o" "$ul_padding"
      done
    else
      echo $line >> $repo/$tidx
    fi
    if [[ $line == *'<ul'* ]]; then
      in_ul=1
      tmp_ln="$line"
      while [[ ${tmp_ln[1]} == ' ' ]]; do
        ul_padding+=' '
        tmp_ln=${tmp_ln# }
      done
      ul_padding+='  '
    fi
  done < "$repo/$idx"
}

pages=($(find . -path .git -path fonts -prune -o -name index.html | sed 's|\./||g' ))

#echo ${pages[@]}

for page in "${pages[@]}"; do
  echo $page
  clear_ul_lists $page
  update_ul_lists $page
done